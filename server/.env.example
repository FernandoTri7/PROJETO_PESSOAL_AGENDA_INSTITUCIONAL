# Variáveis de ambiente da API — copie para server/.env e preencha.
# NUNCA versione o .env real (já está no .gitignore).

# Ambiente: "production" ativa as travas de segurança (JWT_SECRET obrigatório).
NODE_ENV=development

# Porta da API.
PORT=4000

# Segredo de assinatura do JWT. OBRIGATÓRIO em produção (a API não sobe sem ele).
# Gere um valor forte, ex.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Origens permitidas no CORS, separadas por vírgula. Vazio = libera tudo (apenas em dev).
# Ex.: https://agenda.suainstituicao.org,https://www.suainstituicao.org
CORS_ORIGINS=

# Nível de log do pino: trace | debug | info | warn | error | fatal. Padrão: info.
LOG_LEVEL=info
