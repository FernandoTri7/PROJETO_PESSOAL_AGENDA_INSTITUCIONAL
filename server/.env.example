# Variáveis de ambiente da API — copie para server/.env e preencha.
# NUNCA versione o .env real (já está no .gitignore).

# Ambiente: "production" ativa as travas de segurança (JWT_SECRET obrigatório).
NODE_ENV=development

# Porta da API.
PORT=4000

# Segredo de assinatura do JWT. OBRIGATÓRIO em produção (a API não sobe sem ele).
# Gere um valor forte, ex.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Origens permitidas no CORS, separadas por vírgula. Vazio = libera tudo (apenas em dev).
# Ex.: https://agenda.suainstituicao.org,https://www.suainstituicao.org
CORS_ORIGINS=

# Nível de log do pino: trace | debug | info | warn | error | fatal. Padrão: info.
LOG_LEVEL=info

# URL pública do servidor (usada nos links de RSVP e no callback do Google).
SERVER_URL=http://localhost:4000

# ── E-mail (Fase B — convites). Sem isso, os convites são apenas simulados (logados). ──
# Dica: use o Mailtrap (https://mailtrap.io) para uma caixa de testes.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Agenda Institucional <no-reply@exemplo.com>"

# ── Google OAuth (Fase C — anexo do Drive + gerar link do Meet). ──
# Crie em https://console.cloud.google.com (ative: Google Calendar API, Google Drive API, Google Picker API).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/google/callback
# Chave de API para o Google Picker (frontend). Restrinja por referrer HTTP.
GOOGLE_API_KEY=
# Para onde voltar no app após conectar a conta Google (preview web).
APP_URL=http://localhost:8081
