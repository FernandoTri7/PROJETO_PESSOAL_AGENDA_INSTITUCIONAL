// Agenda Institucional e Pessoal — esquema de dados
// SQLite para desenvolvimento local; trocar provider para "postgresql" na publicação.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// ───────────────────────── Usuários e segurança ─────────────────────────

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  // FUNCIONARIO (PJ) | FAMILIAR (pessoa física)
  kind         String   @default("FUNCIONARIO")
  active       Boolean  @default(true)
  // Preferências do usuário em JSON. Ex: {"notificationsEnabled":true,"useInstitutional":false}
  prefs        String?
  // Vínculo opcional com o cadastro de Associado (identidade institucional; o grau vem de lá).
  associadoId  String?    @unique
  associado    Associado? @relation("UserAssociado", fields: [associadoId], references: [id])
  createdAt    DateTime @default(now())

  memberships        CalendarMember[]
  projectMemberships Membership[]
  ownedProjects      Project[]        @relation("ProjectOwner")
  events             Event[]          @relation("EventCreator")
  tasks              Task[]           @relation("TaskCreator")
  assignedTasks      Task[]           @relation("TaskAssignee")
  sessions           SessionRecord[]  @relation("SessionCreator")
  google             GoogleAccount?
}

// ───────────────────────── Projetos e vínculos (identidade central) ─────────────────────────
// Base única de usuários compartilhada entre projetos (Agenda, Controle Administrativo, futuros).
// O papel da pessoa passa a ser POR projeto (Membership.role), não mais global no User.
// Ver docs/arquitetura-identidade-central.md

model Project {
  id          String   @id @default(cuid())
  // Identificador estável usado no app/rotas: "agenda", "admin", ...
  key         String   @unique
  name        String
  // GESTOR atual do projeto. Imutável exceto por transferência explícita ou ADMIN.
  ownerUserId String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  owner       User?        @relation("ProjectOwner", fields: [ownerUserId], references: [id])
  memberships Membership[]
}

// Vínculo usuário↔projeto: habilita a pessoa no projeto e define seu papel ali.
model Membership {
  id        String   @id @default(cuid())
  userId    String
  projectId String
  // GESTOR | ADMIN | MEMBRO | VISITANTE — papel NESTE projeto
  role      String   @default("MEMBRO")
  // Habilitado/desabilitado neste projeto, sem apagar a conta nem o histórico.
  active    Boolean  @default(true)
  joinedAt  DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@index([projectId, role])
}

// Conta Google conectada por usuário (OAuth) — usada para gerar Meet e anexar do Drive.
model GoogleAccount {
  id           String    @id @default(cuid())
  userId       String    @unique
  email        String?
  accessToken  String
  refreshToken String?
  // Expiração do access token (refrescado automaticamente quando vence).
  expiry       DateTime?
  scope        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ───────────────────────── Agendas (múltiplas, compartilháveis) ─────────────────────────

model Calendar {
  id        String   @id @default(cuid())
  name      String
  // PESSOAL | FAMILIAR | INSTITUCIONAL
  type      String   @default("PESSOAL")
  color     String   @default("#1a73e8")
  createdAt DateTime @default(now())

  members    CalendarMember[]
  events     Event[]
  tasks      Task[]
  taskGroups TaskGroup[]
  birthdays  Birthday[]
  sessions   SessionRecord[]
  // Eventos espelhados de outras agendas que também aparecem aqui.
  eventLinks EventCalendar[]
}

// Categorias de evento (CRUD). A key é gravada em Event.category (string) — sem FK,
// para nunca orfanar eventos; categoria removida vira active=false e cai no cinza de fallback.
model Category {
  id        String   @id @default(cuid())
  key       String   @unique
  label     String
  color     String   @default("#9AA0A6")
  // PESSOAL | FAMILIAR | INSTITUCIONAL | TODAS (TODAS atende todas as agendas)
  scope     String   @default("TODAS")
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CalendarMember {
  id         String @id @default(cuid())
  calendarId String
  userId     String
  // OWNER | EDITOR | VIEWER
  role       String @default("VIEWER")

  calendar Calendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([calendarId, userId])
}

// ───────────────────────── Eventos, tarefas e aniversários ─────────────────────────

model Event {
  id            String   @id @default(cuid())
  calendarId    String
  creatorId     String
  title         String
  description   String?
  location      String?
  start         DateTime
  end           DateTime
  allDay        Boolean  @default(false)
  // REUNIAO | SESSAO | TRABALHO | FAMILIA | VIAGEM | OUTRO ...
  category      String   @default("OUTRO")
  color         String?
  // Regra de recorrência no padrão iCalendar (RRULE), ex: FREQ=WEEKLY;BYDAY=SA
  rrule         String?
  // Minutos antes do evento para notificar, separados por vírgula. Ex: "10,60"
  reminders     String?
  // padrao | publico | privado
  visibility    String   @default("padrao")
  // OCUPADO | LIVRE (disponibilidade exibida na agenda)
  availability  String   @default("OCUPADO")
  // Link de videoconferência (Meet manual agora; gerado via Google na fase C)
  videoConfLink String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  calendar    Calendar        @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  creator     User            @relation("EventCreator", fields: [creatorId], references: [id])
  guests      EventGuest[]
  attachments Attachment[]
  // Agendas adicionais onde este evento aparece (espelho). A agenda dona fica em calendarId.
  links       EventCalendar[]

  @@index([calendarId, start])
}

// Vínculo espelho: faz um evento aparecer também em outra agenda, sem duplicar o registro.
// Excluir/editar o evento reflete em todas as agendas vinculadas.
model EventCalendar {
  id         String @id @default(cuid())
  eventId    String
  calendarId String

  event    Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  calendar Calendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)

  @@unique([eventId, calendarId])
  @@index([calendarId])
}

model EventGuest {
  id        String   @id @default(cuid())
  eventId   String
  email     String
  name      String?
  // PENDENTE | ACEITO | RECUSADO (atualizado via link de RSVP no e-mail de convite)
  status    String   @default("PENDENTE")
  // Token opaco usado no link de RSVP (resposta sem login).
  token     String   @unique @default(cuid())
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

model Attachment {
  id        String   @id @default(cuid())
  eventId   String
  // "link" (URL manual, disponível agora) | "drive" (Google Drive, fase C)
  provider  String   @default("link")
  name      String
  url       String
  mimeType  String?
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

model Task {
  id          String    @id @default(cuid())
  calendarId  String
  userId      String
  // Grupo (seção) opcional dentro da agenda; ao excluir o grupo, a tarefa fica sem grupo.
  groupId     String?
  // Responsável pela tarefa (membro da agenda). Distinto de userId (quem criou).
  assigneeId  String?
  title       String
  description String?
  dueDate     DateTime?
  // BAIXA | MEDIA | ALTA
  priority    String    @default("MEDIA")
  done        Boolean   @default(false)
  // Tarefas da "adição rápida" entram não-ativadas (provisórias na caixa de entrada);
  // se não ativadas dentro do período configurado, vão para a lixeira automaticamente.
  activated   Boolean   @default(true)
  // Lixeira (soft delete): preenchido quando a tarefa é excluída; null = ativa.
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())

  calendar    Calendar         @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  user        User             @relation("TaskCreator", fields: [userId], references: [id])
  assignee    User?            @relation("TaskAssignee", fields: [assigneeId], references: [id])
  group       TaskGroup?       @relation(fields: [groupId], references: [id], onDelete: SetNull)
  attachments TaskAttachment[]

  @@index([calendarId, done])
  @@index([groupId])
  @@index([assigneeId])
  @@index([deletedAt])
}

// Grupo (seção) de tarefas dentro de uma agenda. Ex.: "Bazar", "Manutenção".
model TaskGroup {
  id         String   @id @default(cuid())
  calendarId String
  name       String
  order      Int      @default(0)
  createdAt  DateTime @default(now())

  calendar Calendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  tasks    Task[]

  @@index([calendarId])
}

// Anexo de tarefa (link manual ou arquivo do Google Drive; futuro: áudio).
model TaskAttachment {
  id        String   @id @default(cuid())
  taskId    String
  // "link" (URL manual) | "drive" (Google Drive) | "audio" (gravação, fase 2)
  provider  String   @default("link")
  name      String
  url       String
  mimeType  String?
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model Birthday {
  id         String   @id @default(cuid())
  calendarId String
  name       String
  birthDate  DateTime
  phone      String?
  notes      String?
  createdAt  DateTime @default(now())

  calendar Calendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  // Classificação etária (CRIANCA 0-11, JOVEM 12-17, ADULTO 18+) é calculada na API.

  @@index([calendarId])
}

// ───────────────────────── Módulo: Controle de Sessões ─────────────────────────
// Estrutura derivada dos registros reais (histórico WhatsApp da Assistência).

model SessionRecord {
  id         String   @id @default(cuid())
  calendarId String
  creatorId  String
  date       DateTime
  // ESCALA | ESCALA_ANUAL | INSTRUTIVA | EXTRA | ADVENTICIOS | DIRECAO | QUADRO_DE_MESTRES | COMEMORATIVA | OUTRA
  type       String   @default("ESCALA")
  title      String? // ex: "Sessão de Reis", "Aniversário NRL"

  dirigente         String?
  assistente        String?
  auxAssistente     String? // auxiliares do assistente (texto livre, vários nomes)
  som               String?
  leituraDocumentos String?
  explanacao        String?

  // Vegetal
  vegetalDescricao String? // origem/preparo, uniões, observações de lote
  coadoLitros      Float? // total coado para a sessão
  comungadoLitros  Float? // efetivamente comungado
  retornoLitros    Float? // retorno ao estoque

  // Copos
  coposSimples  Int?
  coposDuplos   Int?
  coposCriancas Int?
  repeticoes    Int?

  // Transmissão da Assistência (só ESCALA/EXTRA): dois Mestres (entrega/pega), gravados em SessionParticipation.
  transmissaoAssistencia Boolean @default(false)
  // Sessão dirigida por autoridade de grau superior (marcador independente da transmissão).
  dirigidaPorAutoridade  Boolean @default(false)

  observacoes String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  calendar Calendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  creator  User     @relation("SessionCreator", fields: [creatorId], references: [id])
  participations SessionParticipation[]

  @@index([calendarId, date])
}

// Participação estruturada: uma linha por (sessão, pessoa, função). Fonte de verdade das estatísticas.
// A pessoa vem da base (associadoId) ou é snapshot de outro núcleo (nomeTexto/grau/nucleo).
model SessionParticipation {
  id        String        @id @default(cuid())
  sessionId String
  session   SessionRecord @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  associadoId String?
  associado   Associado?  @relation(fields: [associadoId], references: [id])
  // Snapshot quando a pessoa não está na base (outro núcleo).
  nomeTexto String?
  grau      String?
  nucleo    String?
  // DIRECAO | EXPLANACAO | LEITURA | SOM | ASSISTENTE | AUX_ASSISTENTE | TRANSMISSAO_ENTREGA | TRANSMISSAO_PEGA
  funcao    String
  // Data denormalizada da sessão (consulta rápida de estatística por período).
  data      DateTime

  @@index([funcao, data])
  @@index([associadoId, funcao])
  @@index([sessionId])
}

// Estoque de vegetal (contagens periódicas e lotes)
model VegetalLote {
  id        String   @id @default(cuid())
  nome      String // ex: "Tucunacá Baliza", "Caupuri Itinga - Preparo NRI 25/07/25"
  origem    String?
  litros    Float
  // GELADEIRA | FORA | OUTRO
  local     String   @default("FORA")
  notas     String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

// ───────────────────────── Cadastro de Associados (sócios) ─────────────────────────
// Importável de planilha (.xls/.xlsx/.csv) ou, no futuro, via API de outro sistema.
// Base para vincular pessoas (ex.: M. Assistente / Auxiliares nos levantamentos de estoque).
model Associado {
  id             String    @id @default(cuid())
  nome           String
  // Grau/quadro na instituição (ex.: "QM").
  grau           String?
  // Aniversário: dia/mês sempre presentes; nascimento completo quando há ano.
  diaNasc        Int?
  mesNasc        Int?
  nascimento     DateTime?
  // CPF armazenado só com dígitos (formatado na borda/UI). Único quando informado.
  cpf            String?   @unique
  // Situação na instituição (ex.: "FREQUENTE").
  status         String?
  celular        String?
  residencial    String?
  email          String?
  emailAlt       String?
  endResidencial String?
  endComercial   String?
  endOutro       String?
  ativo          Boolean   @default(true)
  // Origem do registro: "manual" | "import" | "api".
  origem         String    @default("manual")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Vínculos nos levantamentos de estoque.
  levantamentosAssist Levantamento[]         @relation("LevantamentoAssistente")
  auxiliarEm          LevantamentoAuxiliar[]
  // Conta de login vinculada a este associado (no máximo uma).
  user                User?                  @relation("UserAssociado")
  // Participações em sessões (direção, leitura, assistência etc.).
  participacoes       SessionParticipation[]

  @@index([nome])
  @@index([status])
}

// ───────────────────────── Levantamentos de estoque ─────────────────────────
// Cada levantamento é uma contagem periódica do estoque de vegetal, conduzida por um
// M. Assistente (associado grau QM) e auxiliares, com vários itens (lotes). O total em
// estoque exibido é o do ÚLTIMO levantamento (snapshot atual); os anteriores são histórico.
model Levantamento {
  id           String   @id @default(cuid())
  data         DateTime
  // M. Assistente responsável — quando da base, deve ser associado grau QM (validado na rota).
  assistenteId String?
  assistente   Associado? @relation("LevantamentoAssistente", fields: [assistenteId], references: [id])
  // Snapshot de M. Assistente de OUTRO NÚCLEO (fora da base de associados): só histórico, não cadastra.
  assistenteNome   String?
  assistenteGrau   String?
  assistenteNucleo String?
  notas        String?
  itens        LevantamentoItem[]
  auxiliares   LevantamentoAuxiliar[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([data])
}

// Item (lote) dentro de um levantamento. Substitui o antigo VegetalLote plano.
model LevantamentoItem {
  id             String       @id @default(cuid())
  levantamentoId String
  levantamento   Levantamento @relation(fields: [levantamentoId], references: [id], onDelete: Cascade)
  nome           String
  origem         String?
  litros         Float
  // GELADEIRA | FORA | OUTRO
  local          String       @default("FORA")
  notas          String?

  @@index([levantamentoId])
}

// Auxiliares vinculados a um levantamento. Da base (associadoId) OU de outro núcleo (snapshot manual).
model LevantamentoAuxiliar {
  id             String        @id @default(cuid())
  levantamentoId String
  levantamento   Levantamento  @relation(fields: [levantamentoId], references: [id], onDelete: Cascade)
  // Vínculo com a base de associados (quando a pessoa está na lista).
  associadoId    String?
  associado      Associado?    @relation(fields: [associadoId], references: [id])
  // Snapshot de auxiliar de OUTRO NÚCLEO (fora da base): só histórico, não cadastra.
  nome           String?
  grau           String?
  nucleo         String?

  @@unique([levantamentoId, associadoId])
  @@index([levantamentoId])
}
