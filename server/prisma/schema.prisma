// Agenda Institucional e Pessoal — esquema de dados
// SQLite para desenvolvimento local; trocar provider para "postgresql" na publicação.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// ───────────────────────── Usuários e segurança ─────────────────────────

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  // [LEGADO] Papel global. Mantido em coexistência durante a migração para
  // identidade central — o papel real passa a viver em Membership.role (por projeto).
  // Será removido na Fase 3. Ver docs/arquitetura-identidade-central.md
  // ADMIN | GESTOR | MEMBRO | VISITANTE
  role         String   @default("MEMBRO")
  // FUNCIONARIO (PJ) | FAMILIAR (pessoa física)
  kind         String   @default("FUNCIONARIO")
  active       Boolean  @default(true)
  // Preferências do usuário em JSON. Ex: {"notificationsEnabled":true,"useInstitutional":false}
  prefs        String?
  createdAt    DateTime @default(now())

  memberships        CalendarMember[]
  projectMemberships Membership[]
  ownedProjects      Project[]        @relation("ProjectOwner")
  events             Event[]          @relation("EventCreator")
  tasks              Task[]
  sessions           SessionRecord[]  @relation("SessionCreator")
  google             GoogleAccount?
}

// ───────────────────────── Projetos e vínculos (identidade central) ─────────────────────────
// Base única de usuários compartilhada entre projetos (Agenda, Controle Administrativo, futuros).
// O papel da pessoa passa a ser POR projeto (Membership.role), não mais global no User.
// Ver docs/arquitetura-identidade-central.md

model Project {
  id          String   @id @default(cuid())
  // Identificador estável usado no app/rotas: "agenda", "admin", ...
  key         String   @unique
  name        String
  // GESTOR atual do projeto. Imutável exceto por transferência explícita ou ADMIN.
  ownerUserId String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  owner       User?        @relation("ProjectOwner", fields: [ownerUserId], references: [id])
  memberships Membership[]
}

// Vínculo usuário↔projeto: habilita a pessoa no projeto e define seu papel ali.
model Membership {
  id        String   @id @default(cuid())
  userId    String
  projectId String
  // GESTOR | ADMIN | MEMBRO | VISITANTE — papel NESTE projeto
  role      String   @default("MEMBRO")
  // Habilitado/desabilitado neste projeto, sem apagar a conta nem o histórico.
  active    Boolean  @default(true)
  joinedAt  DateTime @default(now())

  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@index([projectId, role])
}

// Conta Google conectada por usuário (OAuth) — usada para gerar Meet e anexar do Drive.
model GoogleAccount {
  id           String   @id @default(cuid())
  userId       String   @unique
  email        String?
  accessToken  String
  refreshToken String?
  // Expiração do access token (refrescado automaticamente quando vence).
  expiry       DateTime?
  scope        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ───────────────────────── Agendas (múltiplas, compartilháveis) ─────────────────────────

model Calendar {
  id        String   @id @default(cuid())
  name      String
  // PESSOAL | FAMILIAR | INSTITUCIONAL
  type      String   @default("PESSOAL")
  color     String   @default("#1a73e8")
  createdAt DateTime @default(now())

  members    CalendarMember[]
  events     Event[]
  tasks      Task[]
  birthdays  Birthday[]
  sessions   SessionRecord[]
  // Eventos espelhados de outras agendas que também aparecem aqui.
  eventLinks EventCalendar[]
}

// Categorias de evento (CRUD). A key é gravada em Event.category (string) — sem FK,
// para nunca orfanar eventos; categoria removida vira active=false e cai no cinza de fallback.
model Category {
  id        String   @id @default(cuid())
  key       String   @unique
  label     String
  color     String   @default("#9AA0A6")
  // PESSOAL | FAMILIAR | INSTITUCIONAL | TODAS (TODAS atende todas as agendas)
  scope     String   @default("TODAS")
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CalendarMember {
  id         String @id @default(cuid())
  calendarId String
  userId     String
  // OWNER | EDITOR | VIEWER
  role       String @default("VIEWER")

  calendar Calendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([calendarId, userId])
}

// ───────────────────────── Eventos, tarefas e aniversários ─────────────────────────

model Event {
  id          String   @id @default(cuid())
  calendarId  String
  creatorId   String
  title       String
  description String?
  location    String?
  start       DateTime
  end         DateTime
  allDay      Boolean  @default(false)
  // REUNIAO | SESSAO | TRABALHO | FAMILIA | VIAGEM | OUTRO ...
  category    String   @default("OUTRO")
  color       String?
  // Regra de recorrência no padrão iCalendar (RRULE), ex: FREQ=WEEKLY;BYDAY=SA
  rrule       String?
  // Minutos antes do evento para notificar, separados por vírgula. Ex: "10,60"
  reminders   String?
  // padrao | publico | privado
  visibility   String   @default("padrao")
  // OCUPADO | LIVRE (disponibilidade exibida na agenda)
  availability String   @default("OCUPADO")
  // Link de videoconferência (Meet manual agora; gerado via Google na fase C)
  videoConfLink String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  calendar    Calendar        @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  creator     User            @relation("EventCreator", fields: [creatorId], references: [id])
  guests      EventGuest[]
  attachments Attachment[]
  // Agendas adicionais onde este evento aparece (espelho). A agenda dona fica em calendarId.
  links       EventCalendar[]

  @@index([calendarId, start])
}

// Vínculo espelho: faz um evento aparecer também em outra agenda, sem duplicar o registro.
// Excluir/editar o evento reflete em todas as agendas vinculadas.
model EventCalendar {
  id         String @id @default(cuid())
  eventId    String
  calendarId String

  event    Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  calendar Calendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)

  @@unique([eventId, calendarId])
  @@index([calendarId])
}

model EventGuest {
  id        String   @id @default(cuid())
  eventId   String
  email     String
  name      String?
  // PENDENTE | ACEITO | RECUSADO (atualizado via link de RSVP no e-mail de convite)
  status    String   @default("PENDENTE")
  // Token opaco usado no link de RSVP (resposta sem login).
  token     String   @unique @default(cuid())
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

model Attachment {
  id        String   @id @default(cuid())
  eventId   String
  // "link" (URL manual, disponível agora) | "drive" (Google Drive, fase C)
  provider  String   @default("link")
  name      String
  url       String
  mimeType  String?
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

model Task {
  id          String    @id @default(cuid())
  calendarId  String
  userId      String
  title       String
  description String?
  dueDate     DateTime?
  // BAIXA | MEDIA | ALTA
  priority    String    @default("MEDIA")
  done        Boolean   @default(false)
  createdAt   DateTime  @default(now())

  calendar Calendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])

  @@index([calendarId, done])
}

model Birthday {
  id         String   @id @default(cuid())
  calendarId String
  name       String
  birthDate  DateTime
  phone      String?
  notes      String?
  createdAt  DateTime @default(now())

  calendar Calendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  // Classificação etária (CRIANCA 0-11, JOVEM 12-17, ADULTO 18+) é calculada na API.

  @@index([calendarId])
}

// ───────────────────────── Módulo: Controle de Sessões ─────────────────────────
// Estrutura derivada dos registros reais (histórico WhatsApp da Assistência).

model SessionRecord {
  id         String   @id @default(cuid())
  calendarId String
  creatorId  String
  date       DateTime
  // ESCALA | ESCALA_ANUAL | INSTRUTIVA | EXTRA | ADVENTICIOS | DIRECAO | QUADRO_DE_MESTRES | COMEMORATIVA | OUTRA
  type       String   @default("ESCALA")
  title      String? // ex: "Sessão de Reis", "Aniversário NRL"

  dirigente        String?
  assistente       String?
  auxAssistente    String? // auxiliares do assistente (texto livre, vários nomes)
  som              String?
  leituraDocumentos String?
  explanacao       String?

  // Vegetal
  vegetalDescricao String? // origem/preparo, uniões, observações de lote
  coadoLitros      Float?  // total coado para a sessão
  comungadoLitros  Float?  // efetivamente comungado
  retornoLitros    Float?  // retorno ao estoque

  // Copos
  coposSimples  Int?
  coposDuplos   Int?
  coposCriancas Int?
  repeticoes    Int?

  observacoes String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  calendar Calendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  creator  User     @relation("SessionCreator", fields: [creatorId], references: [id])

  @@index([calendarId, date])
}

// Estoque de vegetal (contagens periódicas e lotes)
model VegetalLote {
  id        String   @id @default(cuid())
  nome      String // ex: "Tucunacá Baliza", "Caupuri Itinga - Preparo NRI 25/07/25"
  origem    String?
  litros    Float
  // GELADEIRA | FORA | OUTRO
  local     String   @default("FORA")
  notas     String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}
